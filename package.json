{
  "name": "@abelspithost/commitlint",
  "version": "0.2.1",
  "description": "Shared commitlint preset extending @commitlint/config-conventional with stricter defaults",
  "keywords": [
    "commitlint",
    "commitlint-config",
    "conventional",
    "commits",
    "conventional-commits",
    "husky",
    "git-hooks"
  ],
  "license": "ISC",
  "author": {
    "name": "Abel Spithost",
    "url": "https://github.com/aspithost"
  },
  "homepage": "https://github.com/aspithost/commitlint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aspithost/commitlint.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "init": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.spec.json && tsc -p tsconfig.build.json && npm run deps:check",
    "clean": "rimraf dist",
    "deps:check": "npx -y npm-check-updates --cooldown 2",
    "deps:update": "npx -y npm-check-updates -u --target minor --cooldown 2 && npm install",
    "deps:update:major": "npx -y npm-check-updates -u --cooldown 2 && npm install",
    "lint": "eslint . && npm run publint",
    "publint": "npx -y publint",
    "release": "npx tsx release.config.ts",
    "release:dry-run": "npx -p @abelspithost/conventional-commits-changelog release --dry-run",
    "test:unit": "vitest",
    "test:cov": "vitest run --coverage --coverage.reporter=text",
    "test:cov:ci": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.spec.json",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/format": "^21.2.3",
    "@commitlint/types": "^21.2.3"
  },
  "devDependencies": {
    "@abelspithost/conventional-commits-changelog": "^0.0.3",
    "@abelspithost/eslint-config-ts": "^3.2.1",
    "@abelspithost/tsconfig-node": "^0.1.2",
    "@abelspithost/vitest-config": "^0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "commitlint": "^21.2.4",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
